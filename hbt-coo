function saveDraft(){
  const data={id:{},dir:selVal('dir'),opex:[],capex:[]};
  ['id_cc','id_resp','id_ex','id_data','id_status','id_parecer','id_prem','id_obs'].forEach(k=>data.id[k]=selVal(k));
  document.querySelectorAll('#opexBody tr').forEach(tr=>data.opex.push({cc:tr.querySelector('.cc').value,conta:tr.querySelector('.conta').value,
    desc:tr.querySelector('.desc').value,just:tr.querySelector('.just').value,meses:[...tr.querySelectorAll('.mes')].map(i=>i.value),
    y28:tr.querySelector('.y28').value,y29:tr.querySelector('.y29').value}));
  document.querySelectorAll('#capexBody tr').forEach(tr=>data.capex.push({cc:tr.querySelector('.cc').value,item:tr.querySelector('.item').value,
    desc:tr.querySelector('.desc').value,just:tr.querySelector('.just').value,tipo:tr.querySelector('.tipo').value,
    c27:tr.querySelector('.c27').value,c28:tr.querySelector('.c28').value,c29:tr.querySelector('.c29').value}));
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='HBT-orcamento-COO-rascunho.json';a.click();
}
function loadDraft(ev){
  const file=ev.target.files[0];if(!file)return;const r=new FileReader();
  r.onload=()=>{try{const d=JSON.parse(r.result);
    if(d.dir)document.getElementById('dir').value=d.dir;
    Object.keys(d.id||{}).forEach(k=>{const e=document.getElementById(k);if(e)e.value=d.id[k];});
    document.getElementById('opexBody').innerHTML='';document.getElementById('capexBody').innerHTML='';
    (d.opex||[]).forEach(row=>addOpex(row));(d.capex||[]).forEach(row=>addCapex(row));
    if(!(d.opex||[]).length)addOpex();if(!(d.capex||[]).length)addCapex();recalc();
  }catch(e){alert('Arquivo inválido.');}};r.readAsText(file);ev.target.value='';
}
function init(){
  document.getElementById('dir').innerHTML=opt(DIRETORIAS,DIRETORIAS[0]);
  document.getElementById('id_cc').innerHTML=opt(CCS,CCS[0]);
  document.getElementById('id_data').valueAsDate=new Date();
  ['Aluguel de galpão / armazém','Energia elétrica','Manutenção de máquinas e equipamentos','Frete e logística de distribuição'].forEach(c=>addOpex({conta:c}));
  addCapex({item:'Máquinas e equipamentos de produção',tipo:'Novo'});
  addCapex({item:'Equipamentos de movimentação (empilhadeiras)',tipo:'Reposição'});
  recalc();
}
