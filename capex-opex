<script>
const PIN = '202600';
let entered = '';
function updateDots() {
  for (let i = 0; i < 6; i++)
    document.getElementById('d' + i).classList.toggle('filled', i < entered.length);
}
function pinInput(n) {
  if (entered.length >= 6) return;
  entered += n; updateDots();
  document.getElementById('pin-error').textContent = '';
  if (entered.length === 6) {
    setTimeout(() => {
      if (entered === PIN) {
        document.getElementById('pin-screen').classList.add('hidden');
        document.getElementById('dashboard').classList.add('visible');
      } else {
        document.getElementById('pin-error').textContent = 'Código incorreto. Tente novamente.';
        entered = ''; updateDots();
      }
    }, 200);
  }
}
function pinDel()   { entered = entered.slice(0,-1); updateDots(); document.getElementById('pin-error').textContent = ''; }
function pinClear() { entered = ''; updateDots(); document.getElementById('pin-error').textContent = ''; }
document.addEventListener('keydown', e => {
  if (document.getElementById('pin-screen').classList.contains('hidden')) return;
  if (e.key >= '0' && e.key <= '9') pinInput(e.key);
  else if (e.key === 'Backspace') pinDel();
  else if (e.key === 'Escape') pinClear();
});
</script>
