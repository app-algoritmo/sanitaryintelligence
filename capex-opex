<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HBT · Dashboard Operacional</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap');

:root {
  --navy:      #1A2456;
  --ink:       #1C1C1A;
  --slate:     #4A5270;
  --muted:     #8A8FA8;
  --rule:      #DDD9D0;
  --paper:     #F8F7F3;
  --white:     #FFFFFF;
  --teal:      #0F6E56;
  --teal-lt:   #E2F0EB;
  --teal-bd:   #5DCAA5;
  --amber:     #854F0B;
  --amber-lt:  #FAEEDA;
  --amber-bd:  #EF9F27;
  --purple:    #3C3489;
  --purple-lt: #EEEDFE;
  --purple-bd: #7F77DD;
  --gold:      #B8922A;
  --gold-dk:   #D4AF37;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

/* ── PIN ── */
#pin-screen {
  position: fixed; inset: 0; z-index: 1000;
  background: var(--navy);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 0;
}
#pin-screen.hidden { display: none; }

.pin-logo {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(32px, 5vw, 52px);
  color: #fff; letter-spacing: .04em; margin-bottom: 6px;
}
.pin-sub {
  font-family: 'Inter', sans-serif;
  font-size: clamp(11px, 1.5vw, 14px);
  color: rgba(255,255,255,.4);
  letter-spacing: .14em; text-transform: uppercase; margin-bottom: 52px;
}
.pin-label {
  font-size: 14px; color: rgba(255,255,255,.5);
  margin-bottom: 18px; letter-spacing: .06em;
}
.pin-dots { display: flex; gap: 14px; margin-bottom: 28px; }
.pin-dot {
  width: 14px; height: 14px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,.3);
  transition: background .15s, border-color .15s;
}
.pin-dot.filled { background: var(--gold-dk); border-color: var(--gold-dk); }
.pin-pad { display: grid; grid-template-columns: repeat(3, 72px); gap: 12px; }
.pin-btn {
  height: 72px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 14px; color: #fff;
  font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 400;
  cursor: pointer; transition: background .12s;
}
.pin-btn:hover { background: rgba(255,255,255,.14); }
.pin-btn:active { background: rgba(255,255,255,.22); transform: scale(.97); }
.pin-btn.del { font-size: 15px; color: rgba(255,255,255,.5); }
.pin-error {
  margin-top: 18px; font-size: 13px; color: #F09595;
  height: 20px; text-align: center; letter-spacing: .02em;
}

/* ── DASHBOARD ── */
#dashboard { display: none; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--paper); min-height: 100vh; }
#dashboard.visible { display: block; }

/* HEADER */
header {
  background: var(--navy);
  padding: clamp(20px, 3vw, 36px) clamp(24px, 5vw, 64px);
  display: flex; align-items: center; justify-content: space-between;
}
.hdr-left h1 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(22px, 3.5vw, 38px);
  color: #fff; line-height: 1.1; margin-bottom: 6px;
}
.hdr-left p { font-size: clamp(12px, 1.5vw, 15px); color: rgba(255,255,255,.45); letter-spacing: .03em; }
.hdr-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
.btn-back {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
  border-radius: 8px; padding: 9px 18px;
  color: rgba(255,255,255,.85); font-size: clamp(12px, 1.2vw, 14px);
  font-weight: 500; text-decoration: none; transition: background .15s;
}
.btn-back:hover { background: rgba(255,255,255,.2); color: #fff; }

/* MAIN */
main { max-width: 1400px; margin: 0 auto; padding: clamp(28px, 4vw, 60px) clamp(20px, 5vw, 64px) 80px; }
section { margin-bottom: clamp(48px, 6vw, 80px); }

.section-eyebrow {
  font-size: clamp(11px, 1vw, 13px);
  font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  color: var(--muted); margin-bottom: clamp(20px, 2.5vw, 32px);
  padding-bottom: 12px; border-bottom: 1.5px solid var(--rule);
}

/* ── ONBOARDING PHASES ── */
.phase-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(16px, 2vw, 28px);
}
.phase-card {
  border-radius: 20px;
  padding: clamp(24px, 3vw, 44px) clamp(22px, 2.5vw, 38px);
  border: 1.5px solid;
  display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px);
}
.phase-card.teal   { background: var(--teal-lt);   border-color: var(--teal-bd); }
.phase-card.amber  { background: var(--amber-lt);  border-color: var(--amber-bd); }
.phase-card.purple { background: var(--purple-lt); border-color: var(--purple-bd); }

.phase-tag {
  display: inline-block;
  font-size: clamp(10px, 1vw, 13px);
  font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  padding: 5px 14px; border-radius: 20px;
  width: fit-content;
}
.teal   .phase-tag { background: var(--teal);   color: #fff; }
.amber  .phase-tag { background: var(--amber);  color: #fff; }
.purple .phase-tag { background: var(--purple); color: #fff; }

.phase-title {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(26px, 3.5vw, 46px);
  line-height: 1.1;
}
.teal   .phase-title { color: var(--teal); }
.amber  .phase-title { color: var(--amber); }
.purple .phase-title { color: var(--purple); }

.phase-items { display: flex; flex-direction: column; gap: clamp(10px, 1.2vw, 16px); }
.phase-item {
  background: rgba(255,255,255,.6);
  border-radius: 12px;
  padding: clamp(12px, 1.5vw, 18px) clamp(14px, 1.8vw, 22px);
  display: flex; align-items: flex-start; gap: 14px;
}
.phase-item-dot {
  width: 8px; height: 8px; border-radius: 50%;
  flex-shrink: 0; margin-top: 7px;
}
.teal   .phase-item-dot { background: var(--teal); }
.amber  .phase-item-dot { background: var(--amber); }
.purple .phase-item-dot { background: var(--purple); }

.phase-item-text {
  font-size: clamp(14px, 1.5vw, 19px);
  line-height: 1.5; font-weight: 400;
}
.teal   .phase-item-text { color: #085041; }
.amber  .phase-item-text { color: #633806; }
.purple .phase-item-text { color: #26215C; }

/* ── ESPANHA FLOW ── */
.flow-row {
  display: grid;
  grid-template-columns: 1fr 48px 1fr 48px 1fr 48px 1fr;
  align-items: center;
  margin-bottom: clamp(24px, 3vw, 44px);
}
.flow-node {
  background: var(--white);
  border: 1.5px solid var(--rule);
  border-radius: 16px;
  padding: clamp(18px, 2.2vw, 32px) clamp(14px, 1.8vw, 24px);
  text-align: center;
}
.flow-node.accent { background: var(--navy); border-color: var(--navy); }
.flow-flag { font-size: clamp(28px, 3.5vw, 44px); margin-bottom: 8px; }
.flow-title { font-size: clamp(14px, 1.6vw, 20px); font-weight: 600; color: var(--ink); }
.flow-node.accent .flow-title { color: #fff; }
.flow-desc { font-size: clamp(11px, 1.1vw, 14px); color: var(--muted); margin-top: 6px; line-height: 1.5; }
.flow-node.accent .flow-desc { color: rgba(255,255,255,.55); }
.flow-arrow { text-align: center; color: var(--gold); font-size: clamp(20px, 2.5vw, 32px); }

.esp-pillars { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(14px, 2vw, 24px); }
.pillar {
  background: var(--white); border: 1.5px solid var(--rule);
  border-radius: 16px; padding: clamp(20px, 2.5vw, 36px);
}
.pillar-eyebrow {
  font-size: clamp(10px, 1vw, 13px); font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;
}
.pillar-title { font-size: clamp(17px, 2vw, 26px); font-weight: 600; color: var(--navy); margin-bottom: 16px; }
.pillar-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.pillar-list li {
  font-size: clamp(13px, 1.4vw, 18px); color: var(--slate);
  padding-left: 18px; position: relative; line-height: 1.55;
}
.pillar-list li::before { content: '—'; position: absolute; left: 0; color: var(--rule); }

/* ── BUDGET BRASIL ── */
.budget-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: clamp(14px, 2vw, 24px); margin-bottom: clamp(14px, 2vw, 20px);
}
.budget-card { background: var(--white); border: 1.5px solid var(--rule); border-radius: 16px; overflow: hidden; }
.budget-head {
  padding: clamp(12px, 1.5vw, 18px) clamp(16px, 2vw, 24px);
  font-size: clamp(13px, 1.4vw, 17px); font-weight: 600; color: #fff;
}
.budget-head.capex  { background: var(--gold); }
.budget-head.opex   { background: #1C5E8A; }
.budget-head.people { background: var(--purple); }

.budget-body { padding: clamp(14px, 1.8vw, 24px); }
.budget-line {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: clamp(7px, .9vw, 11px) 0; border-bottom: 1px solid #F4F2EE; gap: 10px;
}
.budget-line:last-child { border-bottom: none; }
.budget-line-label { font-size: clamp(13px, 1.3vw, 17px); color: var(--ink); flex: 1; }
.budget-line-val { font-size: clamp(13px, 1.3vw, 17px); font-weight: 600; color: var(--slate); white-space: nowrap; }
.budget-total-row {
  margin-top: 12px; padding-top: 12px; border-top: 2px solid var(--rule);
  display: flex; justify-content: space-between;
  font-size: clamp(14px, 1.5vw, 19px); font-weight: 700; color: var(--navy);
}

.total-banner {
  background: var(--navy); border-radius: 16px;
  padding: clamp(20px, 2.5vw, 32px) clamp(24px, 3vw, 44px);
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
}
.total-banner-label { font-size: clamp(14px, 1.6vw, 20px); color: rgba(255,255,255,.6); }
.total-banner-note  { font-size: clamp(11px, 1vw, 14px); color: rgba(255,255,255,.35); margin-top: 4px; }
.total-banner-val   { font-size: clamp(26px, 4vw, 50px); font-weight: 700; color: #fff; white-space: nowrap; }

/* ── ESPANHA BUDGET ── */
.esp-budget { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2vw, 24px); }
.esp-card { background: var(--white); border: 1.5px solid var(--rule); border-radius: 16px; overflow: hidden; }
.esp-head { padding: clamp(12px, 1.5vw, 18px) clamp(16px, 2vw, 24px); font-size: clamp(13px, 1.4vw, 17px); font-weight: 600; color: #fff; }
.esp-head.capex   { background: var(--gold); }
.esp-head.opex    { background: #1C5E8A; }
.esp-head.brasil  { background: var(--teal); }
.esp-head.blocker { background: #5F6B8A; }
.esp-body { padding: clamp(14px, 1.8vw, 24px); }
.esp-line {
  display: flex; align-items: flex-start; gap: 12px;
  padding: clamp(8px, 1vw, 13px) 0; border-bottom: 1px solid #F4F2EE;
  font-size: clamp(13px, 1.3vw, 17px); color: var(--ink); line-height: 1.5;
}
.esp-line:last-child { border-bottom: none; }
.esp-line-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 6px; background: var(--rule); }
.esp-tbd {
  display: inline-block; font-size: clamp(10px, .9vw, 12px);
  background: #FFEECC; color: #8B6000; border-radius: 4px;
  padding: 2px 7px; font-weight: 600; margin-left: 8px; white-space: nowrap;
}
.esp-note {
  margin-top: 14px; font-size: clamp(12px, 1.1vw, 15px); color: var(--muted);
  font-style: italic; background: var(--paper); border-radius: 10px;
  padding: 10px 14px; line-height: 1.6;
}

/* FOOTER */
footer {
  background: var(--navy);
  padding: clamp(16px, 2vw, 24px) clamp(24px, 5vw, 64px);
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  flex-wrap: wrap;
}
footer span { font-size: clamp(11px, 1vw, 13px); color: rgba(255,255,255,.3); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .phase-row { grid-template-columns: 1fr; }
  .budget-grid { grid-template-columns: 1fr; }
  .esp-budget { grid-template-columns: 1fr; }
  .esp-pillars { grid-template-columns: 1fr; }
  .flow-row { grid-template-columns: 1fr; gap: 8px; }
  .flow-arrow { transform: rotate(90deg); font-size: 24px; }
}
@media (max-width: 640px) {
  header { flex-direction: column; align-items: flex-start; gap: 16px; }
  .hdr-right { align-items: flex-start; }
  footer { flex-direction: column; text-align: center; }
}
</style>
</head>
<body>

<!-- PIN -->
<div id="pin-screen">
  <div class="pin-logo">HBT</div>
  <div class="pin-sub">Dashboard Operacional</div>
  <div class="pin-label">Código de acesso</div>
  <div class="pin-dots">
    <div class="pin-dot" id="d0"></div><div class="pin-dot" id="d1"></div>
    <div class="pin-dot" id="d2"></div><div class="pin-dot" id="d3"></div>
    <div class="pin-dot" id="d4"></div><div class="pin-dot" id="d5"></div>
  </div>
  <div class="pin-pad">
    <button class="pin-btn" onclick="pinInput('1')">1</button>
    <button class="pin-btn" onclick="pinInput('2')">2</button>
    <button class="pin-btn" onclick="pinInput('3')">3</button>
    <button class="pin-btn" onclick="pinInput('4')">4</button>
    <button class="pin-btn" onclick="pinInput('5')">5</button>
    <button class="pin-btn" onclick="pinInput('6')">6</button>
    <button class="pin-btn" onclick="pinInput('7')">7</button>
    <button class="pin-btn" onclick="pinInput('8')">8</button>
    <button class="pin-btn" onclick="pinInput('9')">9</button>
    <button class="pin-btn del" onclick="pinClear()">✕</button>
    <button class="pin-btn" onclick="pinInput('0')">0</button>
    <button class="pin-btn del" onclick="pinDel()">⌫</button>
  </div>
  <div class="pin-error" id="pin-error"></div>
</div>

<!-- DASHBOARD -->
<div id="dashboard">

<header>
  <div class="hdr-left">
    <h1>HBT · Dashboard Operacional</h1>
    <p>Paulo Barros · Diretor de Operações Globais · Hub Norway</p>
  </div>
  <div class="hdr-right">
    <a href="access.html" class="btn-back">← Ferramentas</a>
    <span style="font-size:13px;color:rgba(255,255,255,.35)">Handmade Brazilian Tobacco · Julho 2026</span>
  </div>
</header>

<main>

  <!-- ONBOARDING -->
  <section>
    <div class="section-eyebrow">Plano de onboarding</div>
    <div class="phase-row">

      <div class="phase-card teal">
        <div>
          <div class="phase-tag">Fase 1</div>
          <div class="phase-title" style="margin-top:14px">Diagnóstico</div>
        </div>
        <div class="phase-items">
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Chão de fábrica — gargalos reais de produção</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Qualidade — lacunas vs. ISO 9001 / 14001</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Digitalização — o que existe vs. planilhas soltas</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Entrevistas, visitas e mapeamento de processos</div>
          </div>
        </div>
      </div>

      <div class="phase-card amber">
        <div>
          <div class="phase-tag">Fase 2</div>
          <div class="phase-title" style="margin-top:14px">Estabilização</div>
        </div>
        <div class="phase-items">
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Processos — padronizar antes de certificar</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Logística — fluxo até a porta do cliente</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Indicadores — KPIs mínimos de controle</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Eliminar o que gera custo ou risco operacional agora</div>
          </div>
        </div>
      </div>

      <div class="phase-card purple">
        <div>
          <div class="phase-tag">Fase 3</div>
          <div class="phase-title" style="margin-top:14px">Estruturação formal</div>
        </div>
        <div class="phase-items">
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">ISO 9001 / 14001 — roadmap de certificação</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Governança — estrutura e times definidos</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Expansão — plano formal por mercado</div>
          </div>
          <div class="phase-item">
            <div class="phase-item-dot"></div>
            <div class="phase-item-text">Espanha, outros mercados e plano plurianual</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ESPANHA -->
  <section>
    <div class="section-eyebrow">Expansão internacional — modelo fabril Espanha</div>

    <div class="flow-row">
      <div class="flow-node accent">
        <div class="flow-flag">🇧🇷</div>
        <div class="flow-title">Brasil — Origem</div>
        <div class="flow-desc">Cultivo, blend e exportação de folhas. Design de embalagem central. Equipe de exportação.</div>
      </div>
      <div class="flow-arrow">→</div>
      <div class="flow-node">
        <div class="flow-flag">🚢</div>
        <div class="flow-title">Exportação / Logística</div>
        <div class="flow-desc">Frete marítimo. Despacho aduaneiro. Importação regulada na Espanha.</div>
      </div>
      <div class="flow-arrow">→</div>
      <div class="flow-node accent">
        <div class="flow-flag">🇪🇸</div>
        <div class="flow-title">Espanha — Fábrica</div>
        <div class="flow-desc">Recebimento, armazenagem, corte, embalagem e acabamento. Equipe fabril local.</div>
      </div>
      <div class="flow-arrow">→</div>
      <div class="flow-node">
        <div class="flow-flag">🏪</div>
        <div class="flow-title">Distribuição Local</div>
        <div class="flow-desc">Parceiros distribuidores e equipe comercial. Espanha + expansão Europa.</div>
      </div>
    </div>

    <div class="esp-pillars">
      <div class="pillar">
        <div class="pillar-eyebrow">Brasil · suporte à exportação</div>
        <div class="pillar-title">Estrutura no Brasil</div>
        <ul class="pillar-list">
          <li>Equipe de exportação / COMEX</li>
          <li>Design de embalagem centralizado</li>
          <li>Blend de folhas preparado para padrão exportação</li>
          <li>Certificações de exportação (MAPA e similares)</li>
          <li>Integração logística com operadora de frete internacional</li>
        </ul>
      </div>
      <div class="pillar">
        <div class="pillar-eyebrow">Espanha · operação local</div>
        <div class="pillar-title">Estrutura na Espanha</div>
        <ul class="pillar-list">
          <li>Constituição legal e licenças de fabricação de tabaco</li>
          <li>Galpão industrial — recebimento, armazenagem e produção</li>
          <li>Máquina de corte de tabaco</li>
          <li>Equipamento de embalagem e acabamento</li>
          <li>Equipe fabril local (operadores de produção)</li>
          <li>Country Manager + suporte operacional</li>
          <li>Parcerias com distribuidores e equipe comercial local</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CAPEX/OPEX BRASIL -->
  <section>
    <div class="section-eyebrow">CAPEX e OPEX · Orçamento 2026 — Operações Brasil</div>
    <div class="budget-grid">

      <div class="budget-card">
        <div class="budget-head capex">CAPEX — Investimento</div>
        <div class="budget-body">
          <div class="budget-line"><span class="budget-line-label">Modernização manufatura</span><span class="budget-line-val">R$ 684.845</span></div>
          <div class="budget-line"><span class="budget-line-label">TI e ERP (NEO fases)</span><span class="budget-line-val">R$ 298.193</span></div>
          <div class="budget-line"><span class="budget-line-label">Manutenção e instalações</span><span class="budget-line-val">R$ 69.000</span></div>
